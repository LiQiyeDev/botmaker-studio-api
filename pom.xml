<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      groupId is com.github.LiQiyeDev, exactly as in botmaker-shared and botmaker-session and for the same
      reason: JitPack serves this repo as com.github.LiQiyeDev:botmaker-studio-api:<tag> regardless of what
      this pom says, so matching it here makes the reactor GAV identical to the published GAV. The version
      below is cosmetic — JitPack overrides it with the git tag.
    -->
    <groupId>com.github.LiQiyeDev</groupId>
    <artifactId>botmaker-studio-api</artifactId>
    <version>0.0.0-SNAPSHOT</version>

    <name>BotMaker Studio Plugin API</name>
    <description>
        The contract a BotMaker Studio plugin compiles against: what it contributes to the palette, and how
        it edits a value slot. Interfaces and records only — no implementation, no Studio types.
    </description>

    <!--
      This module deliberately does NOT run flatten-maven-plugin, unlike botmaker-session and botmaker-sdk.
      Flatten is there to bake a -D-injected ${botmaker.*.version} into the published pom; this module has no
      property-driven dependency to bake. Its one dependency is javafx-controls at a literal version, in
      `provided` scope, so the committed pom is already the pom a consumer needs.

      It also has no .deps.env for the same reason: it pins no BotMaker upstream, so there is nothing for a
      release to record and nothing for jitpack.yml to source.
    -->
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21</javafx.version>
        <junit.version>5.10.2</junit.version>
        <!-- The published tag japicmp compares this build against. This module has never been released, so
             the baseline does not resolve yet and ignoreMissingOldVersion below reports rather than fails;
             set it to the previous tag in every release commit from the first one onward. Offline builds
             that have never fetched it pass -Dbotmaker.japicmp.skip=true. -->
        <botmaker.japicmp.baseline>v1.0.0</botmaker.japicmp.baseline>
        <botmaker.japicmp.skip>false</botmaker.japicmp.skip>
    </properties>

    <dependencies>
        <!--
          A slot editor returns a javafx.scene.Node. That pins the plugin platform to JavaFX permanently and
          it is a decision, not an oversight: a UI-factory abstraction able to express the bespoke editors
          (image template, capture source, launch target) would be larger than JavaFX itself.

          `provided` is what keeps it off everyone else's classpath. Studio brings its own JavaFX; the SDK
          declares JavaFX optionally for the editors it ships; and a generated bot resolves neither, because
          a provided-scope dependency is never transitive.
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.17.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- japicmp — the contract is binary-compatible with every plugin already compiled against it.

                 A plugin's .class files cannot be rewritten by anyone, which is the whole reason this module
                 is separate from the SDK, and the trap 25-compatibility.md lists under "not checked by
                 anything" is the one this catches: adding a component to a public record changes its
                 canonical constructor descriptor and throws NoSuchMethodError in every already-built plugin
                 — source-compatible, binary-incompatible, and until now carried by a Javadoc sentence.

                 Unconditional, which is what makes it legitimate where the SDK's August gate was not: that
                 one had to tell an intended break from an accident and could not see the version. Here there
                 is no legitimate break to distinguish — only a Studio major release may make one, and that
                 is the release that edits this block. So no ignore list, no exemption annotation, no verdict
                 file. No postAnalysisScript either: its bundled Groovy cannot read Java 26 class files. -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <version>0.23.1</version>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <oldVersion>
                        <dependency>
                            <groupId>com.github.LiQiyeDev</groupId>
                            <artifactId>botmaker-studio-api</artifactId>
                            <version>${botmaker.japicmp.baseline}</version>
                            <type>jar</type>
                        </dependency>
                    </oldVersion>
                    <parameter>
                        <onlyModified>true</onlyModified>
                        <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                        <includes>
                            <include>com.botmaker.plugin.api</include>
                        </includes>
                        <breakBuildBasedOnSemanticVersioning>false</breakBuildBasedOnSemanticVersioning>
                        <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                        <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                        <includeSynthetic>false</includeSynthetic>
                        <ignoreMissingClasses>true</ignoreMissingClasses>
                    </parameter>
                    <skip>${botmaker.japicmp.skip}</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
